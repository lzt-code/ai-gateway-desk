{
  "name": "ai-gateway-desk",
  "version": "1.0.0",
  "type": "module",
  "description": "AI Gateway 模型管理工具（本地 Web 界面）+ 转发封装 Worker",
  "bin": {
    "aigd": "src/bin/aigd.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "data/providers.example.json",
    "data/models.example.json"
